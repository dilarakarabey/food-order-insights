{
  "description": "Excel export must succeed with Python site-packages disabled and no spreadsheet library installed",
  "test_mode": {
    "python_flag": "-S",
    "meaning": "Do not import site-packages"
  },
  "expected": {
    "exit_code": 0,
    "writer": "stdlib-ooxml",
    "third_party_dependencies": 0,
    "archive_valid": true,
    "required_sheets": [
      "Orders",
      "Items",
      "Data Quality"
    ],
    "orders_columns": [
      "order_ref",
      "ordered_at",
      "message_received_at",
      "provider",
      "status",
      "currency",
      "food_subtotal",
      "delivery_fee",
      "discount",
      "total_paid"
    ],
    "items_columns": [
      "order_ref",
      "item_name",
      "quantity"
    ],
    "preserved_features": [
      "typed_dates",
      "typed_numbers",
      "cell_styles",
      "column_widths",
      "freeze_panes",
      "filters",
      "formula_injection_guard",
      "quiet_mode",
      "verbose_mode"
    ]
  },
  "forbidden_runtime_actions": [
    "import_xlsxwriter",
    "import_openpyxl",
    "dependency_loader",
    "package_install",
    "network_download",
    "alternate_spreadsheet_skill"
  ]
}
